{
  // =========================
  // Agents 定义
  // =========================
  "sisyphus_agent": {
      "default_builder_enabled": true,
      "replace_plan": false,
  },
  "agents": {
    // -------------------------------------------------
    // PRIMARY AGENTS（Top agent，可 Tab 切换）
    // -------------------------------------------------

    "sisyphus": {
      // 主编排器 / 执行总控
      // 负责：任务拆解、子代理调度、全流程推进
      "description": "总控。负责：任务拆解、子代理调度、全流程推进",
      "model": "openai/gpt-5.2-codex",
      "variant": "high",
    },

    "prometheus": {
      // Planner / 架构与计划生成
      // 负责：复杂任务的结构化计划、步骤设计
      "description": "架构师。负责：复杂任务的结构化计划、步骤设计",
      "model": "openai/gpt-5.2",
      "variant": "medium",
    },

    "hephaestus": {
      // Builder / 实现执行
      // 负责：代码生成、重构、具体实现
      "description": "实现者。负责：代码生成、重构、具体实现",
      "model": "openai/gpt-5.2-codex",
      "variant": "medium",
    },

    "atlas": {
      // Reviewer / 全局一致性与质量审查
      // 负责：检查实现是否符合最初目标、发现遗漏
      "description": "审查者。负责：检查实现是否符合最初目标、发现遗漏",
      "model": "github-copilot/claude-sonnet-4.5",
      "variant": "medium",
    },

    // -------------------------------------------------
    // SUBAGENTS（不可 Tab，供 primary 调用）
    // -------------------------------------------------

    "metis": {
      // 计划顾问 / 规划校正
      // 负责：评审或改进 Prometheus 给出的 plan
      "mode": "subagent",
      "model": "openai/gpt-5.2",
      "variant": "medium",
    },

    "oracle": {
      // 判断型专家 / 风险与可行性评估
      // 负责：是非判断、方案取舍、边界条件分析
      "mode": "subagent",
      "model": "openai/gpt-5.2",
      "variant": "medium",
    },

    "explore": {
      // 轻量探索 / 快速试探
      // 负责：低成本探索想法、扫一眼可行性
      "mode": "subagent",
      "model": "github-copilot/gpt-5-mini",
      "variant": "fast",
    },

    "librarian": {
      // 信息整理 / 摘要与结构化
      // 负责：长输出压缩、资料整理、总结
      "mode": "subagent",
      "model": "github-copilot/claude-haiku-4.5",
      "variant": "fast",
    },

    "momus": {
      // 反例与质疑者
      // 负责：挑战假设、指出盲点
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-4.5",
      "variant": "medium",
    },

    "multimodal-looker": {
      // 多模态观察者
      // 负责：图片 / 视觉输入理解（非长上下文核心路径）
      "mode": "subagent",
      "model": "github-copilot/gemini-3-pro-preview",
      "variant": "medium",
    },
  },

  // =========================
  // Categories（模型路由标签）
  // =========================
  "categories": {
      "quick": {
      // 快速、低成本回答
      "model": "github-copilot/claude-haiku-4.5",
      },

      "deep": {
      // 深度推理 / 严肃讨论
      "model": "openai/gpt-5.2",
      "variant": "medium",
      },

      "ultrabrain": {
      // 极重任务（长上下文 + 多轮推理）
      "model": "openai/gpt-5.2-codex",
      "variant": "high",
      },

      "visual-engineering": {
      // 图像 / 视觉相关工程任务
      "model": "github-copilot/gemini-3-pro-preview",
      },

      "artistry": {
      // 设计 / 创意 / 视觉表达
      "model": "github-copilot/gemini-3-flash-preview",
      },

      "unspecified-low": {
      // 未分类的轻任务，尽量省额度
      "model": "github-copilot/gpt-4o",
      },

      "unspecified-high": {
      // 未分类但需要认真回答的任务
      "model": "openai/gpt-5.2",
      },
  },

  // =========================
  // Background Task 并发控制
  // =========================
  "background_task": {
      "defaultConcurrency": 3,
      "providerConcurrency": {
          "openai": 2,
          "github-copilot": 4,
      },
      "modelConcurrency": {
          "openai/gpt-5.2": 2,
          "openai/gpt-5.2-codex": 1,
      },
      "staleTimeoutMs": 180000,
  },

  // =========================
  // 上下文压缩（仍建议开启）
  // =========================
  "compaction": {
    // 上下文接近上限时自动压缩
    "auto": true,
    // 删除旧的 tool 输出，防止 token 爆炸
    "prune": true,
  },
}
