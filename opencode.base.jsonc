{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@tarquinen/opencode-dcp",
    "@mohak34/opencode-notifier",
    "oh-my-opencode@latest",
    "opencode-websearch-cited@1.2.0",
    // "opencode-openai-codex-auth"
  ],
  "mcp": {
    // 【文档搜索】搜索各种框架和库的官方文档
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },

    // 【代码搜索】在GitHub上搜索代码示例
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
    },

    "websearch": {
      "enabled": true,
    },
  },

  // TUI配置
  "tui": {
    "scroll_speed": 3,
    "scroll_acceleration": {
      "enabled": true,
    },
    "diff_style": "auto",
  },

  // =======================================================================
  // 上下文压缩配置
  // =======================================================================
  "compaction": {
    "auto": true, // 上下文满时自动压缩
    "prune": true, // 删除旧的工具输出以节省token
  },

  "autoupdate": "notify", // true, false, notify

  // ============================================================================
  // Agent配置
  // ============================================================================
  "agent": {
    "sk-research": {
      "model": "doubao/glm-4.7",
    },
    "sk-explore": {
      "model": "github-copilot/claude-haiku-4.5",
      "variant": "thinking",
    },
  },

  // =======================================================================
  // 文件监视器配置 - 完整的忽略规则
  // =======================================================================
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "node_modules/**",
      "**/bower_components/**",
      "bower_components/**",

      "dist/**",
      "build/**",
      ".next/**",
      "out/**",
      ".nuxt/**",
      ".output/**",
      ".vite/**",

      ".git/**",
      ".svn/**",

      ".cache/**",
      ".parcel-cache/**",
      "**/.turbo/**",
      ".yarn/**",
      ".pnp.*",

      "**/*.log",
      "logs/**",
      "**/*.tmp",
      "**/*.temp",

      "**/.DS_Store",
      "**/Thumbs.db",

      ".vscode/**",
      ".idea/**",
      "*.swp",
      "*.swo",
      ".root/**",
      ".opencode/**",
      ".sisyphus/**",
      ".specify/**",
    ],
  },

  // =======================================================================
  // 模型提供商配置
  // =======================================================================

  "provider": {
    "openai": {
      "options": {
        "websearch_cited": {
          "model": "gpt-5.1-codex-mini",
        },
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": ["reasoning.encrypted_content"],
        "store": false,
      },
      "models": {
        "gpt-5.2": {
          "name": "GPT 5.2 (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000,
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "variants": {
            "none": {
              "reasoningEffort": "none",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium",
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium",
            },
          },
        },
        "gpt-5.3-codex": {
          "name": "GPT 5.3 Codex (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000,
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium",
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium",
            },
          },
        },
        "gpt-5.1-codex-mini": {
          "name": "GPT 5.1 Codex Mini (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000,
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium",
            },
          },
        },
      },
    },

    "doubao": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Doubao Coding Plan",
      "options": {
        "baseURL": "{env:DOUBAO_PLAN_BASE_URL}",
        "apiKey": "{env:DOUBAO_API_KEY}",
      },
      "models": {
        "kimi-k2.5": {
          "name": "Kimi-K2.5",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
          "options": {
            "thinking": {
              "type": "disabled",
            },
          },
          "variants": {
            "thinking": {
              "thinking": {
                "type": "enabled",
              },
            },
          },
          "limit": {
            "context": 256000,
            "output": 32000,
          },
        },
        "doubao-seed-code": {
          "name": "Doubao-Seed-Code",
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"],
          },
          "options": {
            "thinking": {
              "type": "disabled",
            },
          },
          "variants": {
            "thinking": {
              "thinking": {
                "type": "enabled",
              },
            },
          },
          "limit": {
            "context": 256000,
            "output": 32000,
          },
        },
        "glm-4.7": {
          "name": "GLM-4.7",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
          "options": {
            "thinking": {
              "type": "disabled",
            },
          },
          "variants": {
            "thinking": {
              "thinking": {
                "type": "enabled",
              },
            },
          },
          "limit": {
            "context": 200000,
            "output": 128000,
          },
        },
        "deepseek-v3.2": {
          "name": "DeepSeek-V3",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
          "options": {
            "thinking": {
              "type": "disabled",
            },
          },
          "variants": {
            "thinking": {
              "thinking": {
                "type": "enabled",
              },
            },
          },
          "limit": {
            "context": 1280000,
            "output": 32000,
          },
        },
      },
    },
  },
}
